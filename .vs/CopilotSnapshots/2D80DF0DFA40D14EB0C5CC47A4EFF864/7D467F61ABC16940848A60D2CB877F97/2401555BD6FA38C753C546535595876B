using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using TMPro;

public class Reproductot : MonoBehaviour
{
    [Header("Motor de audio")]
    public MonoBehaviour motorAudio;

    [Header("UI textos")]
    public TextMeshProUGUI tituloText;

    [Header("UI carátula")]
    public Image imagenCaratula;

    [Header("UI Slider")]
    public Slider sliderTiempo;

    [Header("Reproducibles")]
    public List<IContenidoAudio> contenidos = new List<IContenidoAudio>();

    public int indiceActual = 0;

    private IMotorAudio audio;

    [Header("Clips")]
    public AudioClip clip1;
    public AudioClip clip2;
    public AudioClip clip3;

    [Header("Carátulas")]
    public Sprite caratula1;
    public Sprite caratula2;
    public Sprite caratula3;

    public bool reproduciendo = false;

    // Evita que CambiarProgreso() se ejecute
    // mientras actualizamos el slider automáticamente.
    private bool actualizandoSlider = false;

    void Start()
    {
        audio = motorAudio as IMotorAudio;
        if (audio == null)
        {
            Debug.LogError("El componente asignado en motorAudio no implementa IMotorAudio");
            // Evitar NullReferenceException; opcionalmente asignar un fallback aquí.
        }

        // Agregar contenidos
        contenidos.Add(
            new Cancion(
                "johnnybacon156-fah-469417",
                "Davo",
                clip1,
                caratula1
            )
        );

        contenidos.Add(
            new Cancion(
                "idoberg-relaxing-guitar-loop-v5-245859",
                "La cobra",
                clip2,
                caratula2
            )
        );

        contenidos.Add(
            new Podcast(
                "diamond_tunes-cinematic-sound-effect-327618",
                "Messi",
                clip3,
                caratula3
            )
        );

        // Cargar primera canción
        CargarCancion(0);

        // Escuchar cambios manuales del slider
        sliderTiempo.onValueChanged.AddListener(CambiarProgreso);
    }

    void Update()
    {
        if (reproduciendo && audio.Duracion() > 0)
        {
            ActualizarSlider();
            Actualizartiempo(audio.Tiempo);

            // Si terminó el contenido, pasar al siguiente
            if (audio.Tiempo >= audio.Duracion() - 0.1f)
            {
                Siguiente();
            }
        }
    }

    void CargarCancion(int indice)
    {
        if (indice < 0 || indice >= contenidos.Count)
            return;

        indiceActual = indice;

        // Cargar el contenido en tu motor de audio
        audio.Cargar(contenidos[indice]);

        // Actualizar información visual
        tituloText.text = contenidos[indice].GetInfo();
        imagenCaratula.sprite = contenidos[indice].GetCaratula();

        // Reiniciar slider

        actualizandoSlider = true;
        sliderTiempo.minValue = 0;
        sliderTiempo.maxValue = audio.Duracion();
        sliderTiempo.value = 0;
        actualizandoSlider = false;

        reproduciendo = true;

        audio.Reproducir();
    }

    void Reproducir()
    {
        audio.Reproducir();
        reproduciendo = true;
    }

    public void Pausar()
    {
        audio.Pausar();
        reproduciendo = false;
    }

    public void Siguiente()
    {
        if (contenidos.Count == 0)
            return;

        int siguiente = indiceActual + 1;

        if (siguiente >= contenidos.Count)
        {
            siguiente = 0;
        }

        CargarCancion(siguiente);
    }

    public void Anterior()
    {
        if (contenidos.Count == 0)
            return;

        int anterior = indiceActual - 1;

        if (anterior < 0)
        {
            anterior = contenidos.Count - 1;
        }

        CargarCancion(anterior);
    }

    // --------------------------------------------------
    // SLIDER
    // --------------------------------------------------

    void ActualizarSlider()
    {
        if (audio.Duracion() <= 0)
            return;

        actualizandoSlider = true;

        sliderTiempo.maxValue = audio.Duracion();
        sliderTiempo.value = audio.Tiempo;

        actualizandoSlider = false;
    }

    public void CambiarProgreso(float valor)
    {
        // No hacer nada si el cambio viene de ActualizarSlider()
        if (actualizandoSlider)
            return;

        audio.Tiempo = valor;
    }

    void Actualizartiempo(float tiempo)
    {
        // Aquí puedes actualizar un texto como:
        // "01:24 / 03:45"

        // Ejemplo:
        // tiempoText.text = FormatearTiempo(tiempo) + 
        //                   " / " + FormatearTiempo(audio.Duracion());
    }

    string FormatearTiempo(float segundos)
    {
        int minutos = Mathf.FloorToInt(segundos / 60);
        int segundosRestantes = Mathf.FloorToInt(segundos % 60);

        return minutos.ToString("00") + ":" +
               segundosRestantes.ToString("00");
    }
}
